<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device transfer are disabled: schedules stay local.
     Users back up explicitly through Settings > Backup & Restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
